@startuml

skinparam agent {
	FontColor #111111
	BorderThickness 2
	BackgroundColor<<Endpoint>> #F3F4F6
	BorderColor<<Endpoint>> #4B5563
	BackgroundColor<<HealthcareService>> #FFF5E6
	BorderColor<<HealthcareService>> #D48806
	BackgroundColor<<InsurancePlan>> #FFEAF1
	BorderColor<<InsurancePlan>> #BE185D
	BackgroundColor<<Location>> #FFE2C2
	BorderColor<<Location>> #CC5200
	BackgroundColor<<Network>> #BFDBFE
	BorderColor<<Network>> #1E40AF
	BackgroundColor<<Organization>> #EEFBEF
	BorderColor<<Organization>> #2E7D32
	BackgroundColor<<OrganizationAffiliation>> #FCEBFF
	BorderColor<<OrganizationAffiliation>> #A21CAF
	BackgroundColor<<Group>> #EAFBFD
	BorderColor<<Group>> #0E95A3
	BackgroundColor<<PractitionerRole>> #EEF4FF
	BorderColor<<PractitionerRole>> #1E3A8A
}

agent Endpoint as RelResource2_endpoint <<Endpoint>>
agent HealthcareService as RelResource2_healthcareService <<HealthcareService>>
agent InsurancePlan as RelResource2_insurance <<InsurancePlan>>
agent Location as RelResource2_location <<Location>>
agent Organization as RelResource2_network <<Network>>
agent Organization as RelResource2_organization <<Organization>>
agent OrganizationAffiliation as RelResource2_organizationaffiliation <<OrganizationAffiliation>>
agent Group as RelResource2_group <<Group>>
agent PractitionerRole as RelResource2_practitionerrole <<PractitionerRole>>


RelResource2_healthcareService -down-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_insurance -down-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_location -down-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_network -up-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_organization -up-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_organizationaffiliation -up-> RelResource2_endpoint : "endpoint 0..*"
RelResource2_group -up-> RelResource2_endpoint : "extension[endpoint] 0..*"
RelResource2_practitionerrole -up-> RelResource2_endpoint : "endpoint 0..*"

@enduml