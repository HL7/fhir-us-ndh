@startuml

skinparam svgLinkTarget _top
skinparam hyperlinkUnderline false
skinparam agent {
	FontColor #111111
	BorderThickness 2
	BackgroundColor<<Endpoint>> #F3F4F6
	BorderColor<<Endpoint>> #4B5563
	BackgroundColor<<HealthcareService>> #FFF5E6
	BorderColor<<HealthcareService>> #D48806
	BackgroundColor<<InsurancePlan>> #FFEAF1
	BorderColor<<InsurancePlan>> #BE185D
	BackgroundColor<<Location>> #FFE2C2
	BorderColor<<Location>> #CC5200
	BackgroundColor<<Network>> #BFDBFE
	BorderColor<<Network>> #1E40AF
	BackgroundColor<<Organization>> #EEFBEF
	BorderColor<<Organization>> #2E7D32
	BackgroundColor<<OrganizationAffiliation>> #FCEBFF
	BorderColor<<OrganizationAffiliation>> #A21CAF
	BackgroundColor<<Group>> #EAFBFD
	BorderColor<<Group>> #0E95A3
	BackgroundColor<<PractitionerRole>> #EEF4FF
	BorderColor<<PractitionerRole>> #1E3A8A
}

agent Endpoint as endpoint <<Endpoint>> [[StructureDefinition-ndh-Endpoint.html{NDH Endpoint profile}]]
agent HealthcareService as healthcareService <<HealthcareService>> [[StructureDefinition-ndh-HealthcareService.html{NDH HealthcareService profile}]]
agent InsurancePlan as insurance <<InsurancePlan>> [[StructureDefinition-ndh-InsurancePlan.html{NDH InsurancePlan profile}]]
agent Location as location <<Location>> [[StructureDefinition-ndh-Location.html{NDH Location profile}]]
agent Organization as network <<Network>> [[StructureDefinition-ndh-Network.html{NDH Network profile}]]
agent Organization as organization <<Organization>> [[StructureDefinition-ndh-Organization.html{NDH Organization profile}]]
agent OrganizationAffiliation as organizationaffiliation <<OrganizationAffiliation>> [[StructureDefinition-ndh-OrganizationAffiliation.html{NDH OrganizationAffiliation profile}]]
agent Group as group <<Group>> [[StructureDefinition-ndh-Group.html{NDH Group profile}]]
agent PractitionerRole as practitionerrole <<PractitionerRole>> [[StructureDefinition-ndh-PractitionerRole.html{NDH PractitionerRole profile}]]


healthcareService -down-> endpoint : "endpoint 0..*" 
insurance -down-> endpoint : "endpoint 0..*" 
location -down-> endpoint : "endpoint 0..*" 
network -up-> endpoint : "endpoint 0..*" 
organization -up-> endpoint : "endpoint 0..*" 
organizationaffiliation -up-> endpoint : "endpoint 0..*" 
group -up-> endpoint : "extension[endpoint] 0..*" 
practitionerrole -up-> endpoint : "endpoint 0..*"

@enduml