@startuml

agent "Network1" as UsecaseRel2_Network1
agent "Network2" as UsecaseRel2_Network2
agent "OrgManage\nNetwork" as UsecaseRel2_OrgManageNetwork
agent #LightGreen "OrgOneWith\nNetwork1AndNetwork2" as UsecaseRel2_OrgOneWithNetwork1AndNetwork2
agent #LightYellow "OrgOneNetwork1\nAffiliation" as UsecaseRel2_OrgOneNetwork1Affiliation
agent #LightYellow "OrgOneNetwork2\nAffiliation" as UsecaseRel2_OrgOneNetwork2Affiliation
agent "InsurancePlan\nMedicare Advantage" as UsecaseRel2_InsurancePlanMedicareAdvantage
agent "InsurancePlan\nMedicare Advantage HMO" as UsecaseRel2_InsurancePlanMedicareAdvantageHMO


UsecaseRel2_OrgOneNetwork1Affiliation -right-> UsecaseRel2_OrgOneWithNetwork1AndNetwork2
UsecaseRel2_OrgOneNetwork1Affiliation -left-> UsecaseRel2_Network1

UsecaseRel2_OrgOneNetwork2Affiliation -left-> UsecaseRel2_OrgOneWithNetwork1AndNetwork2
UsecaseRel2_OrgOneNetwork2Affiliation -right-> UsecaseRel2_Network2
UsecaseRel2_Network1 -down-> UsecaseRel2_OrgManageNetwork
UsecaseRel2_Network2 -down-> UsecaseRel2_OrgManageNetwork

UsecaseRel2_InsurancePlanMedicareAdvantage -down-> UsecaseRel2_Network1
UsecaseRel2_InsurancePlanMedicareAdvantageHMO -down-> UsecaseRel2_Network2


@enduml