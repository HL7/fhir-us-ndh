@startuml

object "Practitioner" as Provider_api_p
object "PractitionerRole" as Provider_api_pr #LightGreen
Provider_api_pr : the relationships among a practitioner, \norganization, network ...
object "Organization" as Provider_api_o #LightBlue
Provider_api_o : where the practitioner works
object "Organization" as Provider_api_o2  #LightBlue
Provider_api_o2 : payer
object "Location" as Provider_api_l
Provider_api_l : where the practitioner \nprovide services
object "Network" as Provider_api_n
object "Endpoint" as Provider_api_e1 #LightGoldenRodYellow
Provider_api_e1 : Provider endpoint
object "Endpoint" as Provider_api_e2 #LightGoldenRodYellow
Provider_api_e2 : Provider endpoint
object "Endpoint" as Provider_api_e3 #LightGoldenRodYellow
Provider_api_e3 : Payer endpoint
object "Endpoint" as Provider_api_e4 #LightGoldenRodYellow
Provider_api_e4 : Provider endpoint \nat the given location
object "InsurancePlan" as Provider_api_i

Provider_api_p <- Provider_api_pr : practitioner
Provider_api_pr -> Provider_api_o : organization
Provider_api_o -down-> Provider_api_e2 : endpoint
Provider_api_pr -down-> Provider_api_l : location
Provider_api_l -right-> Provider_api_e4 : endpoint
Provider_api_pr -up-> Provider_api_n : network
Provider_api_o2 <-left- Provider_api_n : partOf:
Provider_api_o2 -right-> Provider_api_e3
Provider_api_pr -down-> Provider_api_e1 : endpoint
Provider_api_i -> Provider_api_n : network

@enduml