@startuml
agent "PractitionerRole \n\n /PractitionerA" as PractitionerRolePractitioner2Address_practitionerRole1
agent "PractitionerRole \n\n /PractitionerB" as PractitionerRolePractitioner2Address_practitionerRole2
agent "Practitioner \n\n /PractitionerA \n\n(Practitioners may have their own work addresses \nwhich are not related to any practitionerRoles. \nFor those usecases, the Practitioner.address should be used)" as PractitionerRolePractitioner2Address_practitionerA
agent "Location \n\n /LocationAB \n .name = AB Clinic \n .address = Office 200 \n .address.use = work \n .type = Outpatient facility " as PractitionerRolePractitioner2Address_locationAB1
agent "Lcation \n\n /LocationA2 \n .name = Office of Practitioner A \n .address = Office 200 Suite A \n .address.use = work \n no value in .type" as PractitionerRolePractitioner2Address_locationA2
agent "Practitioner \n\n /PractitionerB \n\n(Practitioners may have their own work addresses \nwhich are not related to any practitionerRoles \nFor those usecases, the Practitioner.address should be used)" as PractitionerRolePractitioner2Address_practitionerB
agent "Location \n\n /LocationB2 \n .name = Office of Practitioner B \n.address = Office 200 Suite B \n .address.use = work \n no value in .type" as PractitionerRolePractitioner2Address_locationB2

PractitionerRolePractitioner2Address_practitionerRole1 -up-> PractitionerRolePractitioner2Address_practitionerA: "practitioner 0..1"
PractitionerRolePractitioner2Address_practitionerRole1 -right-> PractitionerRolePractitioner2Address_locationAB1: "location[1]"
PractitionerRolePractitioner2Address_practitionerRole1 -down-> PractitionerRolePractitioner2Address_locationA2: "location[2]"
PractitionerRolePractitioner2Address_practitionerRole2 -up-> PractitionerRolePractitioner2Address_practitionerB: "practitioner 0..1"
PractitionerRolePractitioner2Address_practitionerRole2 -left-> PractitionerRolePractitioner2Address_locationAB1: "location[1]"
PractitionerRolePractitioner2Address_practitionerRole2 -down-> PractitionerRolePractitioner2Address_locationB2: "location[2]"


@enduml