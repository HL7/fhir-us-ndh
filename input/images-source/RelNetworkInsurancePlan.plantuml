@startuml

skinparam svgLinkTarget _top
skinparam hyperlinkUnderline false
skinparam agent {
	FontColor #111111
	BorderThickness 2
	BackgroundColor<<HealthcareService>> #FFF5E6
	BorderColor<<HealthcareService>> #D48806
	BackgroundColor<<InsurancePlan>> #FFEAF1
	BorderColor<<InsurancePlan>> #BE185D
	BackgroundColor<<Network>> #BFDBFE
	BorderColor<<Network>> #1E40AF
	BackgroundColor<<Organization>> #EEFBEF
	BorderColor<<Organization>> #2E7D32
	BackgroundColor<<OrganizationAffiliation>> #FCEBFF
	BorderColor<<OrganizationAffiliation>> #A21CAF
	BackgroundColor<<Practitioner>> #E9D5FF
	BorderColor<<Practitioner>> #7E22CE
	BackgroundColor<<PractitionerRole>> #EEF4FF
	BorderColor<<PractitionerRole>> #1E3A8A
}

agent OrganizationAffiliation as orgAff <<OrganizationAffiliation>> [[StructureDefinition-ndh-OrganizationAffiliation.html{NDH OrganizationAffiliation profile}]]
agent PractitionerRole as praRole <<PractitionerRole>> [[StructureDefinition-ndh-PractitionerRole.html{NDH PractitionerRole profile}]]
agent Practitioner as practitioner <<Practitioner>> [[StructureDefinition-ndh-Practitioner.html{NDH Practitioner profile}]]
agent "Organization (payer)" as orgpayer <<Organization>> [[StructureDefinition-ndh-Organization.html{NDH Organization profile}]]
agent "Organization (employer)" as orgemp <<Organization>> [[StructureDefinition-ndh-Organization.html{NDH Organization profile}]]
agent "Organization" as organization3 <<Organization>> [[StructureDefinition-ndh-Organization.html{NDH Organization profile}]]
agent "Organization" as network <<Network>> [[StructureDefinition-ndh-Network.html{NDH Network profile}]]
agent InsurancePlan as insurance <<InsurancePlan>> [[StructureDefinition-ndh-InsurancePlan.html{NDH InsurancePlan profile}]]
agent "HealthcareService" as healthcare <<HealthcareService>> [[StructureDefinition-ndh-HealthcareService.html{NDH HealthcareService profile}]]

orgAff -up-> network: "network 0..*"
network -up-> orgpayer: "parterOf 1..1"
insurance -up-> orgpayer: "administeredBy 1..1"
praRole -up-> network: "network 0..*"
praRole -right-> practitioner: "practitioner 0..1"
insurance -left-> network: "network 0..*"
orgemp -down-> insurance: "insuranceplan 0..*"
orgpayer -up-> orgpayer: "parterOf 0..1"
orgemp -up-> orgemp: "parterOf 0..1"
orgAff -up-> organization3: "organization 0..1"
healthcare -up-> network: "network 0..*"


@enduml