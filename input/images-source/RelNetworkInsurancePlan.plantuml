@startuml

skinparam agent {
	FontColor #111111
	BorderThickness 2
	BackgroundColor<<HealthcareService>> #FFF5E6
	BorderColor<<HealthcareService>> #D48806
	BackgroundColor<<InsurancePlan>> #FFEAF1
	BorderColor<<InsurancePlan>> #BE185D
	BackgroundColor<<Network>> #BFDBFE
	BorderColor<<Network>> #1E40AF
	BackgroundColor<<Organization>> #EEFBEF
	BorderColor<<Organization>> #2E7D32
	BackgroundColor<<OrganizationAffiliation>> #FCEBFF
	BorderColor<<OrganizationAffiliation>> #A21CAF
	BackgroundColor<<Practitioner>> #E9D5FF
	BorderColor<<Practitioner>> #7E22CE
	BackgroundColor<<PractitionerRole>> #EEF4FF
	BorderColor<<PractitionerRole>> #1E3A8A
}

agent OrganizationAffiliation as RelNetworkInsurancePlan_orgAff <<OrganizationAffiliation>>
agent PractitionerRole as RelNetworkInsurancePlan_praRole <<PractitionerRole>>
agent Practitioner as RelNetworkInsurancePlan_practitioner <<Practitioner>>
agent "Organization (payer)" as RelNetworkInsurancePlan_orgpayer <<Organization>>
agent "Organization (employer)" as RelNetworkInsurancePlan_orgemp <<Organization>>
agent "Organization" as RelNetworkInsurancePlan_organization3 <<Organization>>
agent "Organization" as RelNetworkInsurancePlan_network <<Network>>
agent InsurancePlan as RelNetworkInsurancePlan_insurance <<InsurancePlan>>
agent "HealthcareService" as RelNetworkInsurancePlan_healthcare <<HealthcareService>>

RelNetworkInsurancePlan_orgAff -up-> RelNetworkInsurancePlan_network: "network 0..*"
RelNetworkInsurancePlan_network -up-> RelNetworkInsurancePlan_orgpayer: "parterOf 1..1"
RelNetworkInsurancePlan_insurance -up-> RelNetworkInsurancePlan_orgpayer: "administeredBy 1..1"
RelNetworkInsurancePlan_praRole -up-> RelNetworkInsurancePlan_network: "network 0..*"
RelNetworkInsurancePlan_praRole -right-> RelNetworkInsurancePlan_practitioner: "practitioner 0..1"
RelNetworkInsurancePlan_insurance -left-> RelNetworkInsurancePlan_network: "network 0..*"
RelNetworkInsurancePlan_orgemp -down-> RelNetworkInsurancePlan_insurance: "insuranceplan 0..*"
RelNetworkInsurancePlan_orgpayer -up-> RelNetworkInsurancePlan_orgpayer: "parterOf 0..1"
RelNetworkInsurancePlan_orgemp -up-> RelNetworkInsurancePlan_orgemp: "parterOf 0..1"
RelNetworkInsurancePlan_orgAff -up-> RelNetworkInsurancePlan_organization3: "organization 0..1"
RelNetworkInsurancePlan_healthcare -up-> RelNetworkInsurancePlan_network: "network 0..*"


@enduml