@startuml

object ":Organization" as ITI_Comprehensive_multi_perspective_nhie #lightgreen
ITI_Comprehensive_multi_perspective_nhie : name = "Big Health Exchange"
ITI_Comprehensive_multi_perspective_nhie : OrgID = 7.8.9

object ":Organization" as ITI_Comprehensive_multi_perspective_Partners #LightBlue
ITI_Comprehensive_multi_perspective_Partners : name = "New Hope\nMedical Partners"

object "orgAff4:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff4
ITI_Comprehensive_multi_perspective_OrgAff4 : code = “HieInitiator”
ITI_Comprehensive_multi_perspective_OrgAff4 --> ITI_Comprehensive_multi_perspective_Partners : participatingOrganization
ITI_Comprehensive_multi_perspective_nhie <-- ITI_Comprehensive_multi_perspective_OrgAff4 : organization

object ":Organization" as ITI_Comprehensive_multi_perspective_hie #lightgreen
ITI_Comprehensive_multi_perspective_hie : name = "Valley Region HIE"
ITI_Comprehensive_multi_perspective_hie : OrgID = 1.2.3.0
ITI_Comprehensive_multi_perspective_hie : HCID = 1.2.3

object "orgAff5:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff5
ITI_Comprehensive_multi_perspective_OrgAff5 : code = “HieResponder”
ITI_Comprehensive_multi_perspective_OrgAff5 --> ITI_Comprehensive_multi_perspective_hie : participatingOrganization
ITI_Comprehensive_multi_perspective_nhie <-- ITI_Comprehensive_multi_perspective_OrgAff5 : organization

object "Valley BigHx Responding Gateway : Endpoint(s)" as ITI_Comprehensive_multi_perspective_rg1 #LightGoldenRodYellow
ITI_Comprehensive_multi_perspective_rg1 : connectionType = "XCDR-RespGateway-DocProvide"
ITI_Comprehensive_multi_perspective_rg1 <-- ITI_Comprehensive_multi_perspective_OrgAff5

object ":Organization" as ITI_Comprehensive_multi_perspective_OU #LightBlue
ITI_Comprehensive_multi_perspective_OU : name = "University Health"
ITI_Comprehensive_multi_perspective_OU : OrgID = 1.2.3.3

object ":Organization" as ITI_Comprehensive_multi_perspective_Urgent #LightBlue
ITI_Comprehensive_multi_perspective_Urgent : name = "Urgent Health"
ITI_Comprehensive_multi_perspective_Urgent : OrgID = 4.5.6.7

object "orgAff1:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff1
ITI_Comprehensive_multi_perspective_OrgAff1 : code = “HieResponder”
ITI_Comprehensive_multi_perspective_OrgAff1 --> ITI_Comprehensive_multi_perspective_Urgent : participatingOrganization
ITI_Comprehensive_multi_perspective_hie <-- ITI_Comprehensive_multi_perspective_OrgAff1 : organization

object "orgAff2:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff2
ITI_Comprehensive_multi_perspective_OrgAff2 : code = “HieInitiator”,\n  “DocShareFederateInt”,\n  “DocShareFederateExt”
ITI_Comprehensive_multi_perspective_OrgAff2 --> ITI_Comprehensive_multi_perspective_OU : participatingOrganization
ITI_Comprehensive_multi_perspective_hie <-- ITI_Comprehensive_multi_perspective_OrgAff2 : organization

object "orgAff3:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff3
ITI_Comprehensive_multi_perspective_OrgAff3 : code = “HieInitiator”,\n  “DocShareFederateInt”,\n  “DocShareFederateExt”
ITI_Comprehensive_multi_perspective_OrgAff3 --> ITI_Comprehensive_multi_perspective_Urgent : participatingOrganization
ITI_Comprehensive_multi_perspective_hie <-- ITI_Comprehensive_multi_perspective_OrgAff3 : organization

object "orgAff6:OrganizationAffiliation" as ITI_Comprehensive_multi_perspective_OrgAff6
ITI_Comprehensive_multi_perspective_OrgAff6 : code = “HieResponder”
ITI_Comprehensive_multi_perspective_OrgAff6 --> ITI_Comprehensive_multi_perspective_OU : participatingOrganization
ITI_Comprehensive_multi_perspective_hie <-- ITI_Comprehensive_multi_perspective_OrgAff6 : organization

object ":Endpoint" as ITI_Comprehensive_multi_perspective_con2 #LightGoldenRodYellow
ITI_Comprehensive_multi_perspective_con2 : connectionType = "XDR-Recipient-ProvideReg"
ITI_Comprehensive_multi_perspective_OrgAff6 --> ITI_Comprehensive_multi_perspective_con2

object "Practitioner" as ITI_Comprehensive_multi_perspective_Dr
ITI_Comprehensive_multi_perspective_Dr : name = "Dr. Santos"

object "PractitionerRole" as ITI_Comprehensive_multi_perspective_Pr
ITI_Comprehensive_multi_perspective_Pr -u-> ITI_Comprehensive_multi_perspective_OU : organization
ITI_Comprehensive_multi_perspective_Pr -> ITI_Comprehensive_multi_perspective_Dr : practitioner
ITI_Comprehensive_multi_perspective_Pr : telecom.system = email
ITI_Comprehensive_multi_perspective_Pr : telecom.value = "dr.santos@universityhealth.org"
ITI_Comprehensive_multi_perspective_Pr : specialty = "Neurology"

@enduml