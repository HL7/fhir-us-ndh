@startuml

agent "OrganizationAffiliation:\n\nOrganizationAffiliation/PharmChainAffil1" as OrganizationAffiliationPharm_orgAffil

agent "Organization:\n\nOrganization/PharmChain" as OrganizationAffiliationPharm_organization1
agent "Network:\n\nOrganization/AcmeofCTStdNet" as OrganizationAffiliationPharm_organization2
agent "Organization:\n\nOrganization/BigBox" as OrganizationAffiliationPharm_organization3
agent "Organization:\n\nOrganization/Acme" as OrganizationAffiliationPharm_organization4

agent "Location:\n\nLocation/PharmLoc1" as OrganizationAffiliationPharm_location1
agent "Location:\n\nLocation/PharmLoc2" as OrganizationAffiliationPharm_location2
agent "Location:\n\nLocation/PharmLoc3" as OrganizationAffiliationPharm_location3
agent "Location:\n\nLocation/PharmLoc4" as OrganizationAffiliationPharm_location4

agent "HealthcareService:\n\nHealthcareService/PharmChainRetailService" as OrganizationAffiliationPharm_healthcareService

OrganizationAffiliationPharm_orgAffil -up-> OrganizationAffiliationPharm_organization1 : "participatingOrganization"
OrganizationAffiliationPharm_orgAffil -down-> OrganizationAffiliationPharm_organization2 : "network"
OrganizationAffiliationPharm_orgAffil -down-> OrganizationAffiliationPharm_location2: "location[1]"
OrganizationAffiliationPharm_organization2 -up-> OrganizationAffiliationPharm_organization4: "partOf"

OrganizationAffiliationPharm_orgAffil -down-> OrganizationAffiliationPharm_location1: "location[0]"
OrganizationAffiliationPharm_orgAffil -down-> OrganizationAffiliationPharm_healthcareService: healthcareService

OrganizationAffiliationPharm_location1 -right-> OrganizationAffiliationPharm_organization2: "extension.fromNetwork"
OrganizationAffiliationPharm_location1 -down-> OrganizationAffiliationPharm_organization3: "managingOrganization"

OrganizationAffiliationPharm_location2 -down-> OrganizationAffiliationPharm_organization2: "extension.fromNetwork"
OrganizationAffiliationPharm_location2 -down-> OrganizationAffiliationPharm_organization3: "managingOrganization"

OrganizationAffiliationPharm_healthcareService -down-> OrganizationAffiliationPharm_location4: location[3]
OrganizationAffiliationPharm_healthcareService -down-> OrganizationAffiliationPharm_location3: location[2]
OrganizationAffiliationPharm_healthcareService -down-> OrganizationAffiliationPharm_location2: Location[1]
OrganizationAffiliationPharm_healthcareService -down-> OrganizationAffiliationPharm_location1: location[0]

OrganizationAffiliationPharm_organization1 -down-> OrganizationAffiliationPharm_healthcareService: provideBy
OrganizationAffiliationPharm_organization2 -left-> OrganizationAffiliationPharm_healthcareService: extension.fromNetwork


@enduml