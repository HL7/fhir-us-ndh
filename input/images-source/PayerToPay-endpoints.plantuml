@startuml

object "Organization" as PayerToPay_endpoints_payer1 #LightGreen
PayerToPay_endpoints_payer1 : payer1

object "Endpoint" as PayerToPay_endpoints_mtlsEndpoint1 #LightGoldenRodYellow
PayerToPay_endpoints_mtlsEndpoint1 : MTLS Endpoint

object "Organization" as PayerToPay_endpoints_payer2 #LightGreen
PayerToPay_endpoints_payer2 : payer2

object "Endpoint" as PayerToPay_endpoints_udapEndpoint1 #LightGoldenRodYellow
PayerToPay_endpoints_udapEndpoint1 : UDAP Well Known Endpoint

object "Organization" as PayerToPay_endpoints_payer3 #LightGreen
PayerToPay_endpoints_payer3 : payer3

object "Endpoint" as PayerToPay_endpoints_mtlsEndpoint2 #LightGoldenRodYellow
