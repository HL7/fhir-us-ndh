@startuml 

title "HIE Access Multi-Level-Community "
object ":Organization" as OrganizationAffiliationIHE3_nhie #lightgreen
OrganizationAffiliationIHE3_nhie : name = "Big Health Exchange"
OrganizationAffiliationIHE3_nhie : OrgID = 7.8.9

object ":Organization" as OrganizationAffiliationIHE3_Partners #LightBlue
OrganizationAffiliationIHE3_Partners : name = "New Hope\nMedical Partners"

object "New Hope BigHx External Initiating Gateway : Endpoint(s)" as OrganizationAffiliationIHE3_ig1 #LightGoldenRodYellow
OrganizationAffiliationIHE3_ig1 : ihe-specific-connection-type =\n  XCPD-InitGateway-PatientDiscovery-AsyncResponse,\n  XCA-InitGateway-Query-AsyncResponse,\n  XCA-InitGateway-Retrieve-AsyncResponse

object "orgAff4:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff4
OrganizationAffiliationIHE3_OrgAff4 : code = “HieResponder”
OrganizationAffiliationIHE3_OrgAff4 --> OrganizationAffiliationIHE3_Partners : participatingOrganization
OrganizationAffiliationIHE3_nhie <-- OrganizationAffiliationIHE3_OrgAff4 : organization
OrganizationAffiliationIHE3_ig1 <-- OrganizationAffiliationIHE3_OrgAff4

object ":Organization" as OrganizationAffiliationIHE3_hie #lightgreen
OrganizationAffiliationIHE3_hie : name = "Valley Region HIE"
OrganizationAffiliationIHE3_hie : OrgID = 1.2.3.0
OrganizationAffiliationIHE3_hie : HCID = 1.2.3

object "orgAff5:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff5
OrganizationAffiliationIHE3_OrgAff5 : code = “HieResponder”
OrganizationAffiliationIHE3_OrgAff5 --> OrganizationAffiliationIHE3_hie : participatingOrganization
OrganizationAffiliationIHE3_nhie <-- OrganizationAffiliationIHE3_OrgAff5 : organization

object "Valley BigHx Responding Gateway : Endpoint(s)" as OrganizationAffiliationIHE3_rg1 #LightGoldenRodYellow
OrganizationAffiliationIHE3_rg1 : ihe-specific-connection-type = \n  XCPD-RespGateway-PatientDiscovery,\n  XCPD-RespGateway-PatientDiscovery-Async,\n  XCA-RespGateway-Query,\n  XCA-RespGateway-Retrieve,\n  XCA-RespGateway-Query-Async,\n  XCA-RespGateway-Retrieve-Async
OrganizationAffiliationIHE3_rg1 <-- OrganizationAffiliationIHE3_OrgAff5

object "Valley BigHx External Initiating Gateway : Endpoint(s)" as OrganizationAffiliationIHE3_ig2 #LightGoldenRodYellow
OrganizationAffiliationIHE3_ig2 : ihe-specific-connection-type =\n  XCPD-InitGateway-PatientDiscovery-AsyncResponse,\n  XCA-InitGateway-Query-AsyncResponse,\n  XCA-InitGateway-Retrieve-AsyncResponse
OrganizationAffiliationIHE3_ig2 <-- OrganizationAffiliationIHE3_OrgAff5

object "Valley BigHx Internal Initiating Gateway : Endpoint(s)" as OrganizationAffiliationIHE3_ig3 #LightGoldenRodYellow
OrganizationAffiliationIHE3_ig3 : ihe-specific-connection-type = \n  XCPD-RespGateway-PatientDiscovery,\n  XCPD-RespGateway-PatientDiscovery-Async,\n  XCA-InitGateway-Query,\n  XCA-InitGateway-Retrieve,\n  XCA-InitGateway-Query-Async,\n  XCA-InitGateway-Retrieve-Async

object "Valley HIE Centralized Services : Endpoint(s)" as OrganizationAffiliationIHE3_hieEndpoints #LightGoldenRodYellow
OrganizationAffiliationIHE3_hieEndpoints : ihe-specific-connection-type = \n  PDQ-Supplier-Query,\n  XDS-Registry-Query,\n  XDS-Registry-Query-Async,\n  XDS-Repository-Retrieve,\n  XDS-Repository-Retrieve-Async,\n  XDS-OnDemandSource-Retrieve,\n  XDS-OnDemandSource-Retrieve-Async

object ":Organization" as OrganizationAffiliationIHE3_OU #LightBlue
OrganizationAffiliationIHE3_OU : name = "University Health"
OrganizationAffiliationIHE3_OU : alias = "OU Health System",\n"OU Health"
OrganizationAffiliationIHE3_OU : OrgID = 1.2.3.3

object ":Organization" as OrganizationAffiliationIHE3_Urgent #LightBlue
OrganizationAffiliationIHE3_Urgent : name = "Urgent Health"
OrganizationAffiliationIHE3_Urgent : OrgID = 4.5.6.7

object "orgAff1:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff1
OrganizationAffiliationIHE3_OrgAff1 : code = “HieResponder”
OrganizationAffiliationIHE3_OrgAff1 --> OrganizationAffiliationIHE3_Urgent : participatingOrganization
OrganizationAffiliationIHE3_hie <-- OrganizationAffiliationIHE3_OrgAff1 : organization

object "orgAff2:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff2
OrganizationAffiliationIHE3_OrgAff2 : code = “HieInitiator”,\n  “DocShareFederateInt”,\n  “DocShareFederateExt”
OrganizationAffiliationIHE3_OrgAff2 --> OrganizationAffiliationIHE3_OU : participatingOrganization
OrganizationAffiliationIHE3_hie <-- OrganizationAffiliationIHE3_OrgAff2 : organization
OrganizationAffiliationIHE3_ig3 <- OrganizationAffiliationIHE3_OrgAff2
OrganizationAffiliationIHE3_OrgAff2 -> OrganizationAffiliationIHE3_hieEndpoints

object "orgAff3:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff3
OrganizationAffiliationIHE3_OrgAff3 : code = “HieInitiator”,\n  “DocShareFederateInt”,\n  “DocShareFederateExt”
OrganizationAffiliationIHE3_OrgAff3 --> OrganizationAffiliationIHE3_Urgent : participatingOrganization
OrganizationAffiliationIHE3_hie <-- OrganizationAffiliationIHE3_OrgAff3 : organization
OrganizationAffiliationIHE3_OrgAff3 -> OrganizationAffiliationIHE3_ig3
OrganizationAffiliationIHE3_OrgAff3 -> OrganizationAffiliationIHE3_hieEndpoints

object "orgAff6:OrganizationAffiliation" as OrganizationAffiliationIHE3_OrgAff6
OrganizationAffiliationIHE3_OrgAff6 : code = “HieResponder”
OrganizationAffiliationIHE3_OrgAff6 --> OrganizationAffiliationIHE3_OU : participatingOrganization
OrganizationAffiliationIHE3_hie <-- OrganizationAffiliationIHE3_OrgAff6 : organization

OrganizationAffiliationIHE3_ig3 -[hidden]- OrganizationAffiliationIHE3_hieEndpoints
OrganizationAffiliationIHE3_OrgAff1 -[hidden] OrganizationAffiliationIHE3_OrgAff3

object ":Endpoint" as OrganizationAffiliationIHE3_con2 #LightGoldenRodYellow
OrganizationAffiliationIHE3_con2 : ihe-specific-connection-type = \n  XDS-Consumer-Query-AsyncResponse,\n  XDS-Consumer-Retrieve-AsyncResponse
OrganizationAffiliationIHE3_OrgAff6 --> OrganizationAffiliationIHE3_con2

object ":Endpoint" as OrganizationAffiliationIHE3_con3 #LightGoldenRodYellow
OrganizationAffiliationIHE3_con3 : ihe-specific-connection-type = \n  XDS-Consumer-Query-AsyncResponse,\n  XDS-Consumer-Retrieve-AsyncResponse
OrganizationAffiliationIHE3_OrgAff1 --> OrganizationAffiliationIHE3_con3

@enduml