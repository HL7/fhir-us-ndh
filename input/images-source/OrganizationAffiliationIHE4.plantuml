@startuml 

title "TEFCA - CareQuality - eHealth Exchange"
object "Organization/eHealth Exchange \n(a QHIN)" as OrganizationAffiliationIHE4_tefca
OrganizationAffiliationIHE4_tefca : OrgID = 1.3.4

object "Endpoint/SutterHealthTefcaEndpoint" as OrganizationAffiliationIHE4_tefcaEp
OrganizationAffiliationIHE4_tefcaEp : address = http://sutter.org/tefca/fhir

object "Organization/Carequality(HIE)" as OrganizationAffiliationIHE4_carequality
OrganizationAffiliationIHE4_carequality : OrgID = 2.4.1\n
OrganizationAffiliationIHE4_carequality : <b>Notes: "HIEs could have own \n<b>Endpoinhts for central, \n<b>services, e.g. \nRecord Locator Service(RLS)"

object "Endpoint/SutterHealthCarequalityEndpoint" as OrganizationAffiliationIHE4_carequalityEp
OrganizationAffiliationIHE4_carequalityEp : address = http://sutter.org/ceq/fhir

object "Organization/SutterHealth" as OrganizationAffiliationIHE4_sutter
OrganizationAffiliationIHE4_sutter : OrgID = 1.2.8.1
OrganizationAffiliationIHE4_sutter : HCID = 1.2.8.1

object "OrganizationAffiliation/OrgAff1" as OrganizationAffiliationIHE4_OrgAff1
OrganizationAffiliationIHE4_OrgAff1 : code = “HieResponder”, \n
OrganizationAffiliationIHE4_OrgAff1 : <b>Notes: "IHE profiled - means a QHIN in TEFCA \n<b>participants can hit this Endpoint"
OrganizationAffiliationIHE4_OrgAff1 -down-> OrganizationAffiliationIHE4_sutter : participatingOrganization
OrganizationAffiliationIHE4_OrgAff1 -up-> OrganizationAffiliationIHE4_tefca : organization
OrganizationAffiliationIHE4_OrgAff1 -up-> OrganizationAffiliationIHE4_tefcaEp : endpoint

object "OrganizationAffiliation/OrgAff2" as OrganizationAffiliationIHE4_OrgAff2
OrganizationAffiliationIHE4_OrgAff2 : code = HieInitiator, \nDocShareFederateInt, \nDocShareFederateExt\n
OrganizationAffiliationIHE4_OrgAff2 : <b>Notes: "HIE/HIO, a QHIN in TEFCA"</b>
OrganizationAffiliationIHE4_OrgAff2 -up-> OrganizationAffiliationIHE4_tefca : organization


object "Organization/A Healthcare Organization" as OrganizationAffiliationIHE4_epic
OrganizationAffiliationIHE4_epic : OrgID = 1.2.8
OrganizationAffiliationIHE4_epic : HCID = 1.2.8
OrganizationAffiliationIHE4_OrgAff2 -down-> OrganizationAffiliationIHE4_epic : participatingOrganization

object "OrganizationAffiliation/OrgAff3" as OrganizationAffiliationIHE4_OrgAff3
OrganizationAffiliationIHE4_OrgAff3 : code = HieInitiator,\nDocShareFederateInt, \nDocShareFederateExt \n
OrganizationAffiliationIHE4_OrgAff3 : <b>Notes: "HIE/HIO, Carequality-Implementer"</b>
OrganizationAffiliationIHE4_OrgAff3 -down-> OrganizationAffiliationIHE4_epic : participatingOrganization
OrganizationAffiliationIHE4_OrgAff3 -up-> OrganizationAffiliationIHE4_carequality : organization

object "OrganizationAffiliation/OrgAff4" as OrganizationAffiliationIHE4_OrgAff4
OrganizationAffiliationIHE4_OrgAff4 : code = “HieResponder”\n
OrganizationAffiliationIHE4_OrgAff4 : Notes: <b> "IHE profiled - means other Carequality \n<b>participants can hit this Endpoint"
OrganizationAffiliationIHE4_OrgAff4 -down-> OrganizationAffiliationIHE4_sutter : participatingOrganization
OrganizationAffiliationIHE4_OrgAff4 -up-> OrganizationAffiliationIHE4_carequality : organization
OrganizationAffiliationIHE4_OrgAff4 -up-> OrganizationAffiliationIHE4_carequalityEp : endpoint

object "OrganizationAffiliation/OrgAff5" as OrganizationAffiliationIHE4_OrgAff5
OrganizationAffiliationIHE4_OrgAff5 : code = “HieInitiator”\n
OrganizationAffiliationIHE4_OrgAff5 : <b>Notes: "TEFCA-Participant, \n<b>Carequality-Connection, \n<b>the Healthecare Organization-Instance etc."
OrganizationAffiliationIHE4_OrgAff5 -up-> OrganizationAffiliationIHE4_epic : organization
OrganizationAffiliationIHE4_OrgAff5 -down-> OrganizationAffiliationIHE4_sutter : participatingOrganization


@enduml
