@startuml

title A practitioner practices in two locations one location is in-network and another location is out-of-network

object "Practitioner" as Provider_in_out_network_p #LightSkyBlue

object "PractitionerRole" as Provider_in_out_network_pr1 #LightGreen
Provider_in_out_network_pr1 : the relationships among a practitioner
Provider_in_out_network_pr1 : organization, network, location, endpoint

object "Organization" as Provider_in_out_network_o #LightBlue
Provider_in_out_network_o : where the practitioner works

object "Organization" as Provider_in_out_network_o2 #LightBlue
Provider_in_out_network_o2 : payer organization

object "PractitionerRole" as Provider_in_out_network_pr2 #LightGreen
Provider_in_out_network_pr2 : the relationships among a practitioner
Provider_in_out_network_pr2 : organization, location, endpoint

object "Location" as Provider_in_out_network_l
Provider_in_out_network_l : the first location where
Provider_in_out_network_l : practitioner provide services
Provider_in_out_network_l : within the insurance coverage area
Provider_in_out_network_l : of the network

Object "Location" as Provider_in_out_network_l2
Provider_in_out_network_l2 : the second location where
Provider_in_out_network_l2 : practitioner provide services
Provider_in_out_network_l2 : outside the insurance coverage area

object "Location" as Provider_in_out_network_l3
Provider_in_out_network_l3 : the insurance coverage area

object "Network" as Provider_in_out_network_n

object "Endpoint" as Provider_in_out_network_e1 #LightGoldenRodYellow
Provider_in_out_network_e1 : Provider endpoint

object "Endpoint" as Provider_in_out_network_e2 #LightGoldenRodYellow
Provider_in_out_network_e2 : Provider endpoint

object "Endpoint" as Provider_in_out_network_e3 #LightGoldenRodYellow
Provider_in_out_network_e3 : Payer endpoint
object "Endpoint" as Provider_in_out_network_e4 #LightGoldenRodYellow
Provider_in_out_network_e4 : Provider endpoint \nat the given location

object "Endpoint" as Provider_in_out_network_e5 #LightGoldenRodYellow
Provider_in_out_network_e5 : Provider endpoint

object "Endpoint" as Provider_in_out_network_e6 #LightGoldenRodYellow
Provider_in_out_network_e6 : Provider endpoint \nat the given location

object "InsurancePlan" as Provider_in_out_network_i #LightPink

Provider_in_out_network_pr1 -down-> Provider_in_out_network_p : practitioner
Provider_in_out_network_pr1 -down-> Provider_in_out_network_o : organization
Provider_in_out_network_o -down-> Provider_in_out_network_e2 : endpoint
Provider_in_out_network_pr1 -up-> Provider_in_out_network_l : location
Provider_in_out_network_l -right-> Provider_in_out_network_e4 : endpoint
Provider_in_out_network_pr1 -right-> Provider_in_out_network_n : network
Provider_in_out_network_o2 -right-> Provider_in_out_network_e3
Provider_in_out_network_pr1 -up-> Provider_in_out_network_e1 : endpoint
Provider_in_out_network_i -up-> Provider_in_out_network_n : network
Provider_in_out_network_n -> Provider_in_out_network_o2 : partOf
Provider_in_out_network_i -right-> Provider_in_out_network_l3 : location

Provider_in_out_network_pr2 -up-> Provider_in_out_network_p : practitioner
Provider_in_out_network_pr2 -up-> Provider_in_out_network_o : organization
Provider_in_out_network_pr2 -down-> Provider_in_out_network_l2 : location
Provider_in_out_network_pr2 -down-> Provider_in_out_network_e5 : endpoint
Provider_in_out_network_l2 -left-> Provider_in_out_network_e6 : endpoint

@enduml