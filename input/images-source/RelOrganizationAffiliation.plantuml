@startuml

skinparam agent {
	FontColor #111111
	BorderThickness 2
	BackgroundColor<<HealthcareService>> #FFF5E6
	BorderColor<<HealthcareService>> #D48806
	BackgroundColor<<Location>> #FFE2C2
	BorderColor<<Location>> #CC5200
	BackgroundColor<<Network>> #BFDBFE
	BorderColor<<Network>> #1E40AF
	BackgroundColor<<Organization>> #EEFBEF
	BorderColor<<Organization>> #2E7D32
	BackgroundColor<<OrganizationAffiliation>> #FCEBFF
	BorderColor<<OrganizationAffiliation>> #A21CAF
}

agent OrganizationAffiliation as RelOrganizationAffiliation_orgAff <<OrganizationAffiliation>>
agent Organization as RelOrganizationAffiliation_organization1 <<Organization>>
agent Organization as RelOrganizationAffiliation_organization2 <<Organization>>
agent Location as RelOrganizationAffiliation_location <<Location>>
agent Organization as RelOrganizationAffiliation_network <<Network>>
agent HealthcareService as RelOrganizationAffiliation_service <<HealthcareService>>


RelOrganizationAffiliation_orgAff -right-> RelOrganizationAffiliation_organization2: "participating organization 0..1"
RelOrganizationAffiliation_orgAff -up-> RelOrganizationAffiliation_organization1:  "organization 0..1"
RelOrganizationAffiliation_orgAff -down-> RelOrganizationAffiliation_service: "healthcare services 0..*"
RelOrganizationAffiliation_orgAff -down-> RelOrganizationAffiliation_network: "networks 0..*"
RelOrganizationAffiliation_orgAff -left-> RelOrganizationAffiliation_location: "locations 0..*"

@enduml