@startuml

agent "OrganizationAffiliation:\n\nOrganizationAffiliation/BurrClinicAffil" as OrganizationAffiliation_orgAffil

agent "Organization:\n\nOrganization/BurrClinic" as OrganizationAffiliation_organization1
agent "Network:\n\nOrganization/AcmeofCTStdNet" as OrganizationAffiliation_organization2
agent "Organization:\n\nOrganization/Acme" as OrganizationAffiliation_organization3
agent "Organization\n\nOrganization/Hospital" as OrganizationAffiliation_organization4
agent "Network:\n\nOrganization/AcmeofCTPremNet" as OrganizationAffiliation_organization5

agent "Location:\n\nLocation/HospLoc1" as OrganizationAffiliation_location1
agent "Location:\n\nLocation/HospLoc2" as OrganizationAffiliation_location2
agent "Location:\n\nLocation/StateOfLocation" as OrganizationAffiliation_location3

agent "HealthcareService:\n\nHealthcareService/BurrClinicServices" as OrganizationAffiliation_healthcareService

agent "InsurancePlan:\n\nInsurancePlan/AcmeQHPGold" as OrganizationAffiliation_insurancePlan1

agent "Endpoint:\n\nEndpoint/AcmeOfCTPortalEndpoint" as OrganizationAffiliation_endpoint1

OrganizationAffiliation_orgAffil -down-> OrganizationAffiliation_organization4 : "organization"
OrganizationAffiliation_orgAffil -down-> OrganizationAffiliation_organization1 : "participatingOrganization"
OrganizationAffiliation_orgAffil -up-> OrganizationAffiliation_organization2 : "network"
OrganizationAffiliation_orgAffil -down-> OrganizationAffiliation_location2: "location"
OrganizationAffiliation_orgAffil -left-> OrganizationAffiliation_healthcareService: "healthcareService"

OrganizationAffiliation_organization2 -right-> OrganizationAffiliation_organization3: "partOf"
OrganizationAffiliation_organization5 -left-> OrganizationAffiliation_organization3: "partOf"

OrganizationAffiliation_insurancePlan1 -down-> OrganizationAffiliation_organization2: "network[0]"
OrganizationAffiliation_insurancePlan1 -right-> OrganizationAffiliation_location3: "coverageArea"
OrganizationAffiliation_insurancePlan1 -left-> OrganizationAffiliation_endpoint1: "endpoint"
OrganizationAffiliation_insurancePlan1 -down-> OrganizationAffiliation_organization3: "administeredBy"
OrganizationAffiliation_insurancePlan1 -down-> OrganizationAffiliation_organization3: "ownedBy"
OrganizationAffiliation_insurancePlan1 -down-> OrganizationAffiliation_organization5: "network[1]"

OrganizationAffiliation_healthcareService -down-> OrganizationAffiliation_location1: "location"
OrganizationAffiliation_healthcareService -down-> OrganizationAffiliation_organization1: "providedBy"

OrganizationAffiliation_location2 -right-> OrganizationAffiliation_organization4: "managingOrganization"

@enduml