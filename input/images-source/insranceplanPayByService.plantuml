@startuml

agent insranceplanPayByService_orgAffil [
    OrganizationAffiliation

    OrganizationAffiliation/OganizationA
    (StatePayerEntityInsurancePlan has 
     a direct contract with an Oganization)
]
agent insranceplanPayByService_insur [
    InsurancePlan
    
    InsurancePlan/StatePayerEntityInsurancePlan
      .type = Medicaid
]
agent insranceplanPayByService_network [
    Network

    Network/LogicalNetwork
]
agent insranceplanPayByService_organization [
    Organization
    
    Organization/OrganizationA
    (OrganizationA has a direct contract
     with a state payer insurance plan)
]
agent insranceplanPayByService_service [
    HealthcareService
    
    HealthcareService/OrganizationA
    (OrganizationA has a direct contract with
     insurancePlan to provide service)
]

insranceplanPayByService_insur -down-> insranceplanPayByService_network : network
insranceplanPayByService_orgAffil -down-> insranceplanPayByService_network : network
insranceplanPayByService_orgAffil -down-> insranceplanPayByService_organization : organization
insranceplanPayByService_orgAffil -left-> insranceplanPayByService_service : healthcareService


@enduml