@startuml

agent #LightGreen"Payer\nOrganization-1" as PayerToPayer_payer1
collections PayerEndpoint as PayerToPayer_payerEndpoint1

agent #LightGreen"Payer\nOrganization-2" as PayerToPayer_payer2
collections PayerEndpoint as PayerToPayer_payerEndpoint2

circle #LightYellow"many payer's organizations to come" as PayerToPayer_futurePayers

agent #LightGreen"Payer\nOrganization-n" as PayerToPayer_payern
collections PayerEndpoint as PayerToPayer_payerEndpoint3

PayerToPayer_payer1 -down-> PayerToPayer_payerEndpoint1 : 1..*
PayerToPayer_payer2 -down-> PayerToPayer_payerEndpoint2 : 1..*
PayerToPayer_payern -down-> PayerToPayer_payerEndpoint3 : 1..*


@enduml