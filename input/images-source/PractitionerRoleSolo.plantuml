@startuml

agent #LightGreen "PractitionerRole:\n\nHansSoloRole" as PractitionerRoleSolo_practitionerRole
agent "Practitioner:\n\nHansSolo" as PractitionerRoleSolo_practitioner

agent "Location:\n\nHansSoloClinic" as PractitionerRoleSolo_location
agent "HealthcareService:\n\nHansSoloService" as PractitionerRoleSolo_healthcareService
agent "InsurancePlan:\n\nBlueCrossBlueShield-CT" as PractitionerRoleSolo_insurancePlan
agent "Network:\n\nBlueCrossBlueShield-CT-PPO" as PractitionerRoleSolo_network
agent "Organization:\n\nBlueCrossBlueShield-CT-ORG" as PractitionerRoleSolo_organization
agent "Endpoint:\n\nHansSoloDirectTrustEndpointReferrals" as PractitionerRoleSolo_directEndpoint
agent "Endpoint:\n\nHansSoloPatientAccessEndpoint" as PractitionerRoleSolo_patientAccessEndpoint

PractitionerRoleSolo_practitionerRole -left-> PractitionerRoleSolo_practitioner : "practitioner"
PractitionerRoleSolo_practitionerRole .left.> PractitionerRoleSolo_practitioner: "specialty"
PractitionerRoleSolo_practitionerRole -right-> PractitionerRoleSolo_healthcareService : "healthcareService"
PractitionerRoleSolo_practitionerRole -down-> PractitionerRoleSolo_network : "network"
PractitionerRoleSolo_practitionerRole -up-> PractitionerRoleSolo_location : "location"
PractitionerRoleSolo_practitionerRole -up-> PractitionerRoleSolo_directEndpoint : "endpoint"
PractitionerRoleSolo_practitionerRole -up-> PractitionerRoleSolo_patientAccessEndpoint : "endpoint"
PractitionerRoleSolo_insurancePlan -up-> PractitionerRoleSolo_network : "network"
PractitionerRoleSolo_network -right-> PractitionerRoleSolo_organization : "partOf"
PractitionerRoleSolo_insurancePlan -up-> PractitionerRoleSolo_organization : "ownedBy"

@enduml